# ===== VibeDev configuration =====
# Copy this file to `.env` and fill in what you need.

# --- Server ---
PORT=4000
NODE_ENV=development
# Where extracted projects live (defaults to ./workspace)
# WORKSPACE_ROOT=/absolute/path/to/workspace

# --- AI provider ---
# Choose: mock | anthropic | openai | auto
#   mock  -> works with no key (demo/deterministic checks)
#   auto  -> uses first real key found, else mock
AI_PROVIDER=mock

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- GitHub OAuth (optional; you can also just use a Personal Access Token) ---
# Create an OAuth App: https://github.com/settings/developers
# Homepage URL:  http://localhost:4000
# Callback URL:  http://localhost:4000/api/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_APP_URL=

# --- Git identity used for commits if the user doesn't provide one ---
GIT_USER=vibedev
GIT_EMAIL=vibedev@localhost

# --- Upload limits (MB) ---
MAX_FILE_SIZE_MB=2000
MAX_UPLOAD_FILES=20

# --- Security / production ---
# Comma-separated origins in production, e.g. https://your-app.onrender.com
# CORS_ORIGIN=https://your-domain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
