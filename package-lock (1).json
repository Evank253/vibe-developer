name: CI

on:
  push:
    branches: [main]
  pull_request:

jobs:
  build-and-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install backend deps
        run: npm install

      - name: Install client deps
        run: npm --prefix client install

      - name: Build client
        run: npm run build:client

      - name: Smoke-test API (health + mock provider)
        run: |
          node -e "import('./server/services/ai/index.js').then(async m=>{const p=m.getProvider('mock');const r=await p.generateCode('hello','Python');if(!r.code)throw new Error('mock gen failed');console.log('mock AI OK:',r.fileName);})"
          echo "✅ Backend imports and mock AI provider work."
