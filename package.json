{
  "name": "vibedev",
  "version": "1.0.0",
  "description": "VibeDev — AI super-developer: connect GitHub, drop in any zip/project, and it reviews, fixes, generates missing code, organizes your files, and deploys — all through a chat copilot.",
  "type": "module",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "dev:client": "npm --prefix client run dev",
    "setup": "npm install && npm --prefix client install",
    "build:client": "npm --prefix client run build",
    "go": "bash start.sh",
    "lint": "eslint server client/src --ext .js,.jsx",
    "lint:fix": "eslint server client/src --ext .js,.jsx --fix",
    "format": "prettier --write \"server/**/*.{js,json}\" \"client/src/**/*.{js,jsx,css}\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"server/**/*.{js,json}\" \"client/src/**/*.{js,jsx,css}\"",
    "test": "node --test server/tests/*.test.js 2>/dev/null || node -e \"import('./server/services/ai/index.js').then(async m=>{const p=m.getProvider('mock');const r=await p.generateCode('hello','Python');if(!r.code)throw new Error('mock gen failed');console.log('OK',r.fileName);})\"",
    "audit": "npm audit --omit=dev",
    "deploy:heroku": "bash scripts/deploy-heroku.sh"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@eslint/js": "^10.0.1",
    "adm-zip": "^0.6.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.3.0",
    "multer": "^2.0.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "eslint": "^9.22.0",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "prettier": "^3.5.3",
    "@eslint/js": "^9.22.0"
  },
  "keywords": [
    "vibe-code",
    "ai",
    "github",
    "copilot",
    "developer",
    "code-review",
    "organizer",
    "deploy"
  ],
  "license": "MIT"
}
